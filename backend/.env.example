# Flask Configuration
SECRET_KEY=changeme-generate-a-random-secret
FLASK_ENV=development

# PostgreSQL Database Configuration
# NOTE: The database name (vehicle_db) must match the database you created in pgAdmin.
DATABASE_URL=postgresql://user:password@localhost:5432/vehicle_db

# Google Gemini API key, used server-side by /api/ocr - never exposed to the frontend
GEMINI_API_KEY=your-gemini-api-key-here
